/* OCR VBHC — light theme. GENERATED by devtools/build_qss.py from
 * devtools/theme_template.qss and theme_tokens.py; edit those, not this file.
 *
 * One template for both themes, so the two can no longer drift apart.
 * Minimal rules of the 2026-10 redesign: flat surfaces separated by hairlines
 * instead of boxes and shadows, one 4px radius for controls, olive for
 * actions and selection, gold only as a small mark, text sizes 10/9/8.5pt.
 * Icons in url() come from icons/qss/ (coloured per theme by the build);
 * @APP_DIR@ is replaced by the app folder when the theme is applied.
 */

/* ============ BASE ============ */
QMainWindow, QDialog {
    background: #EEF0EE;
    color: #18211B;
    font-family: "Be Vietnam Pro", "Segoe UI", sans-serif;
    font-size: 10pt;
}
QWidget {
    color: #18211B;
    font-family: "Be Vietnam Pro", "Segoe UI", sans-serif;
}
QLabel { background: transparent; color: #18211B; }
QLabel[role="muted"] { color: #5D6760; font-size: 9pt; }
QLabel[role="sectionTitle"] { color: #18211B; font-size: 10.5pt; font-weight: 600; }
QLabel[role="emptyTitle"] { color: #18211B; font-size: 14pt; font-weight: 600; }
QLabel[role="documentTitle"] { color: #18211B; }
QLabel[role="metadataValue"] { background: #FFFFFF; padding: 2px 4px; }
QLabel[role="metadataLabel"] { color: #5D6760; font-size: 8.5pt; }
QLabel[role="statusStrong"] { color: #3D6648; font-size: 9pt; font-weight: 600; padding: 0 6px; }
QScrollArea { background: transparent; border: none; }
QFrame#doc_toolbar, QFrame#ocr_header_bar { background: transparent; border: none; }
QFrame#ocr_action_bar { background: #FFFFFF; border: none; border-top: 1px solid #D5DAD5; }
QFrame#ocr_action_bar QPushButton { font-size: 9pt; padding: 3px 10px; min-height: 24px; }
QFrame#commandOverlay { background: #FFFFFF; border: 1px solid #B7BFB8; border-radius: 6px; }
QTextEdit[role="ocrText"] {
    background: #FFFFFF; color: #18211B;
    font-family: "Times New Roman", "Be Vietnam Pro", serif; font-size: 11pt;
    padding: 10px 12px; border: 1px solid #D5DAD5;
}

/* ============ BUTTONS ============ */
/* Default = secondary: surface, hairline, sentence-case label. */
QPushButton {
    background: #FFFFFF;
    color: #18211B;
    border: 1px solid #B7BFB8;
    border-radius: 4px;
    padding: 4px 12px;
    min-height: 24px;
    font-weight: 500;
}
QPushButton:hover    { background: #E8EBE8; }
QPushButton:pressed  { background: #DCE1DC; }
QPushButton:disabled { background: #F6F7F6; color: #5D6760; border-color: #D5DAD5; }
QPushButton:focus    { outline: none; border-color: #7A5D0F; }

/* The one filled button of a view (save, send). */
QPushButton[variant="primary"] {
    background: #2B4A33; color: #FFFFFF; border-color: #2B4A33;
}
QPushButton[variant="primary"]:hover   { background: #36593F; border-color: #36593F; }
QPushButton[variant="primary"]:pressed { background: #2B4A33; }
QPushButton[variant="primary"]:disabled { background: #F6F7F6; color: #5D6760; border-color: #D5DAD5; }

QPushButton[variant="cta"] {
    background: #B3263E; color: #FFFFFF; border-color: #B3263E;
}
QPushButton[variant="cta"]:hover { background: #931E33; border-color: #931E33; }

/* Gold used to be a filled button; now an outlined secondary with gold text. */
QPushButton[variant="gold"] { background: #FFFFFF; color: #7A5D0F; border-color: #B7BFB8; }
QPushButton[variant="gold"]:hover { background: #E8EBE8; }

QPushButton[variant="ghost"] { background: transparent; border-color: transparent; }
QPushButton[variant="ghost"]:hover { background: #E8EBE8; }

QPushButton[variant="danger"] { background: #FFFFFF; color: #B3263E; border-color: #B7BFB8; }
QPushButton[variant="danger"]:hover { background: #E8EBE8; border-color: #B3263E; }

QDialogButtonBox QPushButton { min-width: 72px; }

/* ============ TOOL BUTTONS (icon-only) ============ */
QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
    min-width: 26px;
    min-height: 26px;
}
QToolButton:hover   { background: #E8EBE8; }
QToolButton:pressed { background: #DCE1DC; }
QToolButton:checked { background: #E3EBE5; }
QToolButton:disabled { background: transparent; }
QToolButton::menu-indicator { image: none; width: 0; }
QToolButton[popupMode="1"] { padding-right: 16px; }
QToolButton::menu-button {
    border: none; width: 14px; border-top-right-radius: 4px; border-bottom-right-radius: 4px;
}
QToolButton::menu-button:hover { background: #DCE1DC; }
QToolButton::menu-arrow { image: url(@APP_DIR@/icons/qss/chevron-down-light.svg); width: 10px; height: 10px; }

/* ============ INPUTS ============ */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    background: #FFFFFF;
    color: #18211B;
    border: 1px solid #D5DAD5;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 22px;
    selection-background-color: #E3EBE5;
    selection-color: #18211B;
}
QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QSpinBox:hover { border-color: #B7BFB8; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus,
QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #7A5D0F;
    outline: none;
}
QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled, QDateEdit:disabled {
    background: #F6F7F6;
    color: #5D6760;
}
QLineEdit[readOnly="true"] { background: #F6F7F6; }
/* The small buttons Qt puts inside a line edit (the clear button, icons
   added with addAction) keep their own size: the 26px tool-button minimum
   above would push them off centre. */
QLineEdit QToolButton { min-width: 0; min-height: 0; padding: 0; border: none; background: transparent; }

QComboBox { padding-right: 22px; }
QComboBox::drop-down { border: none; width: 20px; subcontrol-origin: padding; subcontrol-position: center right; }
QComboBox::down-arrow { image: url(@APP_DIR@/icons/qss/chevron-down-light.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: #FFFFFF;
    color: #18211B;
    border: 1px solid #B7BFB8;
    selection-background-color: #E3EBE5;
    selection-color: #18211B;
    padding: 4px;
    outline: none;
}
QDateEdit::drop-down { border: none; width: 20px; }
QDateEdit::down-arrow { image: url(@APP_DIR@/icons/qss/chevron-down-light.svg); width: 12px; height: 12px; }
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { border: none; width: 16px; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(@APP_DIR@/icons/qss/chevron-up-light.svg); width: 10px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(@APP_DIR@/icons/qss/chevron-down-light.svg); width: 10px; height: 10px; }

/* ============ LISTS + TABLES ============ */
QListWidget, QListView, QTreeView, QTreeWidget {
    background: #FFFFFF;
    color: #18211B;
    border: 1px solid #D5DAD5;
    outline: none;
}
QListWidget::item, QListView::item { padding: 2px 4px; border: none; }
QListWidget::item:hover, QListView::item:hover { background: #E8EBE8; }
QListWidget::item:selected, QListView::item:selected { background: #E3EBE5; color: #18211B; }

QTableWidget, QTableView {
    background: #FFFFFF;
    alternate-background-color: #F6F7F6;
    gridline-color: #D5DAD5;
    border: 1px solid #D5DAD5;
    selection-background-color: #E3EBE5;
    selection-color: #18211B;
}
QTableWidget::item, QTableView::item { padding: 4px 8px; }
QTableWidget::item:selected, QTableView::item:selected { background: #E3EBE5; color: #18211B; }
QHeaderView::section {
    background: #F6F7F6;
    color: #48524B;
    padding: 5px 8px;
    border: none;
    border-bottom: 1px solid #D5DAD5;
    font-weight: 600;
    font-size: 9pt;
}
QHeaderView::section:hover { background: #E8EBE8; }

/* ============ TABS ============ */
QTabWidget::pane { border: none; border-top: 1px solid #D5DAD5; background: #FFFFFF; top: -1px; }
QTabBar::tab {
    background: transparent;
    color: #48524B;
    padding: 6px 12px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 500;
}
QTabBar::tab:selected { color: #18211B; border-bottom-color: #2B4A33; }
QTabBar::tab:hover:!selected { color: #18211B; }

/* ============ SCROLLBARS ============ */
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #B7BFB8; border-radius: 3px; min-height: 28px; margin: 1px; }
QScrollBar::handle:vertical:hover { background: #5D6760; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: #B7BFB8; border-radius: 3px; min-width: 28px; margin: 1px; }
QScrollBar::handle:horizontal:hover { background: #5D6760; }
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page { background: none; border: none; width: 0; height: 0; }

/* ============ GROUPS ============ */
/* A section is a hairline and a small title, not a rounded box. */
QGroupBox {
    background: transparent;
    border: none;
    border-top: 1px solid #D5DAD5;
    margin-top: 14px;
    padding: 10px 0 0 0;
    font-weight: 600;
    color: #48524B;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 0;
    padding: 0 6px 0 0;
    color: #48524B;
    font-size: 9pt;
    background: transparent;
}

/* ============ MENUS ============ */
QMenuBar { background: #FFFFFF; color: #18211B; border-bottom: 1px solid #D5DAD5; padding: 2px 6px; }
QMenuBar::item { background: transparent; padding: 4px 10px; border-radius: 4px; }
QMenuBar::item:selected { background: #E8EBE8; }
QMenu {
    background: #FFFFFF;
    color: #18211B;
    border: 1px solid #B7BFB8;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item { padding: 5px 28px 5px 10px; border-radius: 4px; }
QMenu::item:selected { background: #E8EBE8; color: #18211B; }
QMenu::item:disabled { color: #5D6760; }
QMenu::icon { padding-left: 6px; }
QMenu::separator { height: 1px; background: #D5DAD5; margin: 4px 6px; }

/* ============ TOOLBAR ============ */
QToolBar {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #D5DAD5;
    spacing: 2px;
    padding: 2px 6px;
}
QToolBar::separator { background: #D5DAD5; width: 1px; margin: 7px 5px; }

/* ============ STATUSBAR ============ */
QStatusBar {
    background: #FFFFFF;
    border-top: 1px solid #D5DAD5;
    color: #5D6760;
    font-size: 8.5pt;
    padding: 0 8px;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #5D6760; font-size: 8.5pt; }

/* ============ SPLITTER ============ */
QSplitter::handle { background: #D5DAD5; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:hover, QSplitter::handle:pressed { background: #7A5D0F; }

/* ============ PROGRESSBAR ============ */
QProgressBar {
    background: #E8EBE8;
    border: none;
    border-radius: 2px;
    text-align: center;
    max-height: 4px;
    color: transparent;
}
QProgressBar::chunk { background: #2B4A33; border-radius: 2px; }

/* ============ TOOLTIP ============ */
/* Hints and long explanations live here instead of on screen. */
QToolTip {
    background-color: #FFFFFF;
    color: #18211B;
    border: 1px solid #B7BFB8;
    border-radius: 4px;
    padding: 5px 8px;
    font-family: "Be Vietnam Pro", "Segoe UI", sans-serif;
    font-size: 9pt;
}

/* ============ CHECKBOX + RADIO ============ */
QCheckBox, QRadioButton { color: #18211B; spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px; height: 14px; border: 1px solid #B7BFB8; background: #FFFFFF;
}
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked {
    background: #2B4A33; border-color: #2B4A33;
    image: url(@APP_DIR@/icons/qss/check-on-primary.svg);
}
QRadioButton::indicator:checked { background: #FFFFFF; border: 4px solid #2B4A33; }

/* ============ DOCK WIDGET ============ */
QDockWidget { color: #18211B; titlebar-close-icon: none; titlebar-normal-icon: none; }
QDockWidget::title {
    background: #FFFFFF;
    color: #48524B;
    padding: 6px 10px;
    border-bottom: 1px solid #D5DAD5;
    font-weight: 600;
}

/* ============ CALENDAR ============ */
/* QCalendarWidget, used by the date picker and QDateEdit popups. */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: #FFFFFF;
    border-bottom: 1px solid #D5DAD5;
    min-height: 32px;
}
QCalendarWidget QToolButton {
    color: #18211B;
    background: transparent;
    font-weight: 600;
    min-width: 24px;
    min-height: 24px;
    padding: 2px 6px;
}
QCalendarWidget QToolButton:hover { background: #E8EBE8; }
QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: url(@APP_DIR@/icons/qss/chevron-left-light.svg);
}
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: url(@APP_DIR@/icons/qss/chevron-right-light.svg);
}
QCalendarWidget QToolButton::menu-indicator { image: none; }
QCalendarWidget QMenu { min-width: 120px; }
QCalendarWidget QSpinBox {
    min-height: 20px; padding: 0 4px; border: 1px solid #D5DAD5;
    selection-background-color: #E3EBE5; selection-color: #18211B;
}
QCalendarWidget QAbstractItemView:enabled {
    background: #FFFFFF;
    color: #18211B;
    selection-background-color: #2B4A33;
    selection-color: #FFFFFF;
    outline: none;
    border: none;
}
QCalendarWidget QAbstractItemView:disabled { color: #5D6760; }

/* ============ LEGAL CHAT DOCK ============ */
/* Styled by chat_widgets.chat_stylesheet() from theme_tokens, for both themes. */

/* ============ AREA: chrome ============ */
/* The workspace chrome: top toolbar, library panel (Kho văn bản), page
 * navigation in the tab strip, status bar. Quiet surfaces split by
 * hairlines; icons are coloured in code from the same tokens
 * (main_window_1.chrome_icon), so nothing here names an icon colour. */

/* Toolbar: one 34px row of 28px icon buttons. */
QToolBar#main_toolbar {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #D5DAD5;
    padding: 3px;  /* Qt reads this as the frame on every side: 28 + 2 x 3 */
    spacing: 2px;
}
QToolBar#main_toolbar QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
    margin: 0;
    min-width: 28px; max-width: 28px;
    min-height: 28px; max-height: 28px;
}
QToolBar#main_toolbar QToolButton:hover { background: #E8EBE8; }
QToolBar#main_toolbar QToolButton:pressed { background: #DCE1DC; }
QToolBar#main_toolbar QToolButton:checked { background: #E3EBE5; }
/* The theme switch shows its state with its glyph (moon, sun), not a fill. */
QToolBar#main_toolbar QToolButton#theme_toggle:checked { background: transparent; }
QToolBar#main_toolbar QToolButton#theme_toggle:checked:hover { background: #E8EBE8; }
QToolBar#main_toolbar::separator { background: #D5DAD5; width: 1px; margin: 8px 6px; }
/* The open document: type, number (the gold mark), pages. */
QLabel#toolbar_doc_type { color: #48524B; font-size: 9.5pt; }
QLabel#toolbar_doc_number { color: #7A5D0F; font-size: 10pt; font-weight: 600; }
QLabel#toolbar_doc_number[kind="file"] { color: #48524B; font-size: 9.5pt; font-weight: 500; }
QLabel#toolbar_doc_pages { color: #5D6760; font-size: 9pt; }

/* Library panel: title and count, a slim filter, the list on the surface. */
QWidget#library_panel { background: #FFFFFF; }
QLabel#library_title { color: #18211B; font-size: 10pt; font-weight: 600; }
QLabel#library_count { color: #5D6760; font-size: 9pt; }
QLineEdit#library_filter { font-size: 9pt; padding: 0 4px 0 2px; min-height: 0; }
/* Its search and clear icons are QToolButtons too: keep the generic
   26px tool-button size from pushing them off centre. */
QLineEdit#library_filter QToolButton { min-width: 0; min-height: 0; padding: 0; border: none; background: transparent; }
QToolButton#library_sort {
    padding: 0;
    min-width: 26px; max-width: 26px;
    min-height: 26px; max-height: 26px;
}
QToolButton#library_sort:checked { background: #E3EBE5; }
QListWidget#library_list { background: transparent; border: none; outline: none; padding: 0 4px 4px 4px; }
QListWidget#library_list::item { border: none; border-radius: 4px; padding: 0; margin: 0; }
QListWidget#library_list::item:hover { background: #E8EBE8; }
QListWidget#library_list::item:selected { background: #E3EBE5; color: #18211B; }
QLabel#doc_row_title { color: #18211B; font-size: 9.5pt; }
QLabel#doc_row_title[kind="file"] { color: #48524B; }
QLabel#doc_row_date { color: #5D6760; font-size: 8.5pt; }

/* Splitter: a hairline at the edge of a wider grab area. */
QSplitter#workspace_splitter::handle:horizontal { background: #FFFFFF; border-left: 1px solid #D5DAD5; }
QSplitter#workspace_splitter::handle:horizontal:hover { border-left: 1px solid #7A5D0F; }

/* Centre tabs: text with an olive underline, the page navigation at the right. */
QTabWidget#workspace_tabs { background: #FFFFFF; }
QTabWidget#workspace_tabs::pane { border: none; border-top: 1px solid #D5DAD5; top: -1px; background: #FFFFFF; }
QTabWidget#workspace_tabs > QTabBar { background: transparent; }
QTabWidget#workspace_tabs > QTabBar::tab {
    background: transparent;
    color: #48524B;
    font-size: 9.5pt;
    font-weight: 500;
    padding: 8px 0 6px 0;
    margin: 0 8px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabWidget#workspace_tabs > QTabBar::tab:first { margin-left: 12px; }
QTabWidget#workspace_tabs > QTabBar::tab:selected { color: #18211B; border-bottom-color: #3D6648; }
QTabWidget#workspace_tabs > QTabBar::tab:hover:!selected { color: #18211B; }
QWidget#pdf_nav { background: transparent; }
QWidget#pdf_nav QToolButton {
    padding: 0;
    min-width: 26px; max-width: 26px;
    min-height: 26px; max-height: 26px;
}
QWidget#pdf_nav QToolButton#pdf_zoom_reset {
    min-width: 44px; max-width: 44px;
    color: #48524B;
    font-size: 9pt;
}
QWidget#pdf_nav QToolButton#pdf_zoom_reset:disabled { color: #5D6760; }
QLineEdit#pdf_page_field { font-size: 9pt; padding: 0 2px; min-height: 0; }
QLabel#pdf_page_total { color: #5D6760; font-size: 9pt; }
/* "Thông tin tệp": a read-only sheet; NĐ30 levels in their own tokens. */
QWidget#file_info { background: #FFFFFF; }
QLabel[role="fileInfoLabel"] { color: #5D6760; font-size: 9pt; padding-top: 1px; }
QLabel[role="fileInfoValue"] { color: #18211B; font-size: 9.5pt; }
QLabel[role="fileInfoValue"][level="hoa_toc"] { color: #DC2626; font-weight: 600; }
QLabel[role="fileInfoValue"][level="thuong_khan"] { color: #EA580C; font-weight: 600; }
QLabel[role="fileInfoValue"][level="khan"] { color: #B58A12; font-weight: 600; }
QLabel[role="fileInfoValue"][level="mat"] { color: #DB2777; font-weight: 600; }
QLabel[role="fileInfoValue"][level="toi_mat"] { color: #9333EA; font-weight: 600; }
QLabel[role="fileInfoValue"][level="tuyet_mat"] { color: #A21CAF; font-weight: 600; }
/* The page lies on the canvas colour, so the paper reads as paper. */
QScrollArea#pdf_canvas > QWidget#qt_scrollarea_viewport { background: #EEF0EE; }

/* Status bar: small separate parts, explained in their tooltips. */
QStatusBar QLabel#status_doc { color: #5D6760; padding-left: 4px; }
QStatusBar QLabel#status_llama, QStatusBar QLabel#status_vram,
QStatusBar QLabel#status_workers { color: #48524B; }
QStatusBar QLabel#status_llama_state { color: #B3263E; }
QProgressBar#status_vram_bar {
    background: #DCE1DC;
    border: none;
    border-radius: 2px;
    min-height: 4px; max-height: 4px;
}
QProgressBar#status_vram_bar::chunk { background: #3D6648; border-radius: 2px; }
QProgressBar#status_vram_bar[level="mid"]::chunk { background: #D97706; }
QProgressBar#status_vram_bar[level="high"]::chunk { background: #B3263E; }

/* ============ AREA: editor ============ */
/* The document editor (right-hand panel) and its date popover.
 * The panel is one sheet of paper: sections are separated by a hairline and
 * a short title, not boxed. Document content (the full text and the
 * metadata values) is set in Times New Roman like the documents themselves;
 * labels and controls stay sans. A metadata value sits on a hairline, like a
 * filled-in line of a paper form: darker on hover, gold when focused. */
QWidget#ocrResultEditor { background: #FFFFFF; }
QLabel[role="documentType"] { color: #48524B; font-size: 10pt; font-weight: 500; }
QLabel[role="documentNumber"] { color: #7A5D0F; font-size: 10.5pt; font-weight: 600; }
QFrame#editorSectionHeader { background: transparent; border: none; border-top: 1px solid #D5DAD5; }
QLabel[role="editorSectionTitle"] { color: #48524B; font-size: 9pt; font-weight: 600; }
QToolButton#editorExpandButton { min-width: 26px; min-height: 26px; padding: 0; }
QTextEdit[role="ocrText"] {
    background: #FFFFFF;
    color: #18211B;
    border: none;
    padding: 0 6px 6px 12px;
    font-family: "Times New Roman", serif;
    font-size: 11pt;
}
QScrollArea#ocrMetadataScroll, QWidget#ocrMetadataViewport, QWidget#ocrMetadataForm { background: #FFFFFF; }
QLabel[role="metadataLabel"] { color: #5D6760; font-size: 9pt; padding: 5px 0 0 0; }
QLineEdit[role="metadataValue"], QTextEdit[role="metadataValue"], QComboBox[role="metadataValue"] {
    background: transparent;
    color: #18211B;
    border: none;
    border-bottom: 1px solid #D5DAD5;
    border-radius: 0;
    padding: 2px 0 2px 0;
    min-height: 20px;
    font-family: "Times New Roman", serif;
    font-size: 10.5pt;
}
QComboBox[role="metadataValue"] { padding: 2px 22px 2px 2px; }
/* the calendar icon inside the date field keeps its own small size */
QLineEdit[role="metadataValue"] QToolButton { min-width: 0; min-height: 0; padding: 0; border: none; }
QLineEdit[role="metadataValue"]:hover, QTextEdit[role="metadataValue"]:hover,
QComboBox[role="metadataValue"]:hover { border-bottom-color: #B7BFB8; }
QLineEdit[role="metadataValue"]:focus, QTextEdit[role="metadataValue"]:focus,
QComboBox[role="metadataValue"]:focus { border-bottom-color: #7A5D0F; }
QComboBox[role="metadataSelector"] {
    background: transparent;
    color: #5D6760;
    border: none;
    border-radius: 0;
    padding: 0 12px 0 2px;
    min-height: 18px;
    font-size: 8.5pt;
}
QComboBox[role="metadataSelector"]:hover { color: #18211B; }
QComboBox[role="metadataSelector"]::drop-down { width: 12px; }
QComboBox[role="metadataSelector"]::down-arrow { width: 10px; height: 10px; }
QFrame#ocr_action_bar QToolButton { min-width: 30px; min-height: 30px; padding: 0; }
QFrame#ocr_action_bar QPushButton { font-size: 9pt; padding: 3px 12px; min-height: 22px; }
QFrame#ocr_action_bar QPushButton[variant="ghost"]:disabled { background: transparent; border-color: transparent; }

/* Date popover: a 6px-radius surface with a hairline, no window chrome. */
QFrame#datePopup { background: #FFFFFF; border: 1px solid #B7BFB8; border-radius: 6px; }
QToolButton#datePopupTitle { color: #18211B; font-size: 10pt; font-weight: 600; padding: 2px 6px; }
QToolButton#datePopupTitle:disabled { color: #18211B; }
QToolButton#datePopupNav { min-width: 28px; min-height: 28px; padding: 0; }
QLabel[role="datePopupWeekday"] { color: #5D6760; font-size: 8.5pt; padding: 2px 0; }
QToolButton[role="dateCell"] { color: #18211B; font-size: 9.5pt; padding: 6px 4px; }
QToolButton[role="dateCell"][outside="true"] { color: #5D6760; }
QToolButton[role="dateCell"]:checked { background: #2B4A33; color: #FFFFFF; }
QFrame#datePopup QPushButton[variant="ghost"] { color: #3D6648; font-size: 9pt; padding: 2px 8px; min-height: 22px; }
QCalendarWidget#datePopupCalendar QAbstractItemView:enabled {
    font-size: 9.5pt;
    alternate-background-color: #FFFFFF;
}

/* ============ AREA: analytics ============ */
/* The secondary windows: analytics (Phân tích kho văn bản), the AI semantic
 * search, statistics, the index rebuild and the settings. Each is one sheet
 * on the surface like the workspace: header and footer rows split off by
 * hairlines, sections as a short title over a hairline, quiet tables, text
 * tabs with the olive underline, one filled button. Chart colours come from
 * theme_manager_v2.matplotlib_rc; icons are coloured in code from the same
 * tokens, so nothing here names an icon colour. */
QDialog#analyticsDialog, QDialog#aiSearchDialog, QDialog#statisticsDialog,
QDialog#reindexDialog, QDialog#settingsDialog { background: #FFFFFF; }

/* Header, footer, the split between filters and results: hairlines. */
QFrame#analyticsHeader { background: #FFFFFF; border: none; border-bottom: 1px solid #D5DAD5; }
QLabel#analyticsSectionTitle { color: #18211B; font-size: 10.5pt; font-weight: 600; }
QFrame#analyticsHeader QToolButton {
    padding: 0;
    min-width: 30px; max-width: 30px;
    min-height: 30px; max-height: 30px;
}
QFrame#analyticsFooter, QFrame#statisticsFooter, QFrame#settingsFooter {
    background: #FFFFFF; border: none; border-top: 1px solid #D5DAD5;
}
QLabel#analyticsStatus { color: #5D6760; font-size: 8.5pt; }
QSplitter#analyticsSplitter::handle { background: #D5DAD5; }
QSplitter#analyticsSplitter::handle:horizontal { width: 1px; }

/* Filters: four counts as figures, then small sections. */
QWidget#analyticsSearchPanel, QWidget#analyticsSearchContent { background: #FFFFFF; }
QScrollArea#analyticsSearchScroll > QWidget#qt_scrollarea_viewport,
QScrollArea#analyticsChartsScroll > QWidget#qt_scrollarea_viewport { background: #FFFFFF; }
QFrame#stat_card { background: transparent; border: none; }
QDialog#analyticsDialog QLabel#stat_title, QDialog#statisticsDialog QLabel#stat_title { color: #5D6760; font-size: 8.5pt; }
QDialog#analyticsDialog QLabel#stat_value { color: #18211B; font-size: 16pt; font-weight: 600; }
QDialog#statisticsDialog QLabel#stat_value { color: #18211B; font-size: 20pt; font-weight: 600; }
/* A section: the hairline, then its title, then the fields (as the
   editor's sections), the title in the padding so it never meets the line. */
QDialog#analyticsDialog QGroupBox, QDialog#settingsDialog QGroupBox {
    margin-top: 10px;
    padding: 30px 0 0 0;
    border: none;
    border-top: 1px solid #D5DAD5;
    font-size: 9pt;
    font-weight: 600;
}
QDialog#settingsDialog QGroupBox[first="true"] { margin-top: 0; border-top: none; padding-top: 24px; }
QDialog#analyticsDialog QGroupBox::title, QDialog#settingsDialog QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 0;
    top: 9px;
    padding: 0;
    color: #48524B;
}
QDialog#settingsDialog QGroupBox[first="true"]::title { top: 4px; }
/* The checked radio keeps the size of the unchecked one, so it stays round. */
QDialog#settingsDialog QRadioButton::indicator:checked {
    width: 8px; height: 8px; border: 4px solid #2B4A33; border-radius: 8px; background: #FFFFFF;
}
QLabel[role="analyticsFieldLabel"], QLabel[role="settingsLabel"] { color: #48524B; font-size: 9pt; }
QLabel[role="settingsValue"] { color: #18211B; font-size: 9.5pt; }
QDialog#analyticsDialog QLineEdit, QDialog#analyticsDialog QComboBox,
QDialog#analyticsDialog QDateEdit { font-size: 9pt; min-height: 20px; }
QDialog#analyticsDialog QPushButton { font-size: 9pt; padding: 3px 12px; min-height: 22px; }
/* The clear button inside a field keeps its own small size. */
QDialog#analyticsDialog QLineEdit QToolButton, QDialog#aiSearchDialog QLineEdit QToolButton {
    min-width: 0; min-height: 0; padding: 0; border: none; background: transparent;
}

/* Text tabs with the olive underline, as in the workspace. */
QTabWidget#analyticsTabs, QTabWidget#statisticsTabs, QTabWidget#settingsTabs { background: #FFFFFF; }
QTabWidget#analyticsTabs::pane, QTabWidget#statisticsTabs::pane, QTabWidget#settingsTabs::pane {
    border: none; border-top: 1px solid #D5DAD5; top: -1px; background: #FFFFFF;
}
QTabWidget#analyticsTabs > QTabBar, QTabWidget#statisticsTabs > QTabBar,
QTabWidget#settingsTabs > QTabBar { background: transparent; }
QTabWidget#analyticsTabs > QTabBar::tab, QTabWidget#statisticsTabs > QTabBar::tab,
QTabWidget#settingsTabs > QTabBar::tab {
    background: transparent;
    color: #48524B;
    font-size: 9.5pt;
    font-weight: 500;
    padding: 9px 0 7px 0;
    margin: 0 8px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabWidget#analyticsTabs > QTabBar::tab:first, QTabWidget#statisticsTabs > QTabBar::tab:first,
QTabWidget#settingsTabs > QTabBar::tab:first { margin-left: 16px; }
QTabWidget#analyticsTabs > QTabBar::tab:selected, QTabWidget#statisticsTabs > QTabBar::tab:selected,
QTabWidget#settingsTabs > QTabBar::tab:selected { color: #18211B; border-bottom-color: #3D6648; }
QTabWidget#analyticsTabs > QTabBar::tab:hover:!selected, QTabWidget#statisticsTabs > QTabBar::tab:hover:!selected,
QTabWidget#settingsTabs > QTabBar::tab:hover:!selected { color: #18211B; }
QWidget#analyticsTabCorner { background: transparent; }
QLabel#analyticsResultsCount { color: #5D6760; font-size: 9pt; }
QDialog#analyticsDialog QPushButton#show_all_btn { color: #3D6648; padding: 2px 8px; min-height: 20px; }

/* Tables: no frame, no grid, a hairline under the header, quiet rows. */
QTableWidget#analyticsTable, QTableWidget#statisticsTable, QTableWidget#settingsShortcuts {
    background: #FFFFFF;
    alternate-background-color: #F6F7F6;
    border: none;
    font-size: 9pt;
    selection-background-color: #E3EBE5;
    selection-color: #18211B;
}
QTableWidget#analyticsTable::item, QTableWidget#statisticsTable::item,
QTableWidget#settingsShortcuts::item { padding: 0 8px; border: none; }
QTableWidget#analyticsTable QHeaderView::section, QTableWidget#statisticsTable QHeaderView::section,
QTableWidget#settingsShortcuts QHeaderView::section {
    background: #FFFFFF;
    color: #5D6760;
    font-size: 8.5pt;
    font-weight: 600;
    padding: 6px 8px 6px 11px;  /* the cell text starts 3px in from its padding */
    border: none;
    border-bottom: 1px solid #D5DAD5;
}
QTableWidget#analyticsTable QHeaderView::section:hover { background: #E8EBE8; }

/* Charts: a short title over each figure; the figure lies on the surface. */
QWidget#analyticsCharts, QWidget#analyticsChartBlock { background: #FFFFFF; }
QLabel[role="analyticsChartTitle"] { color: #18211B; font-size: 9.5pt; font-weight: 600; }

/* AI semantic search: the field is the header, results are list rows. */
QWidget#aiSearchHeader { background: #FFFFFF; }
QLineEdit#aiSearchInput { font-size: 10.5pt; padding: 4px 8px; min-height: 26px; }
QPushButton#aiSearchButton { min-width: 64px; min-height: 26px; }
QLabel#aiSearchSummary, QLabel#aiSearchStatus { color: #48524B; font-size: 9pt; }
QLabel#aiSearchStatus[state="error"] { color: #B3263E; }
QLabel#aiSearchIndexCount { color: #5D6760; font-size: 8.5pt; }
QToolButton#aiSearchReindex, QToolButton#aiResultExpand, QToolButton#aiResultOpen {
    padding: 0;
    min-width: 26px; max-width: 26px;
    min-height: 26px; max-height: 26px;
}
QListWidget#aiSearchResults {
    background: #FFFFFF; border: none; border-top: 1px solid #D5DAD5; outline: none;
}
QListWidget#aiSearchResults::item { border: none; border-bottom: 1px solid #D5DAD5; padding: 0; margin: 0; }
QListWidget#aiSearchResults::item:hover { background: #F6F7F6; }
QListWidget#aiSearchResults::item:selected { background: #E3EBE5; color: #18211B; }
QFrame#aiResultRow { background: transparent; border: none; }
QLabel#aiResultNumber { color: #18211B; font-size: 10pt; font-weight: 600; }
QLabel#aiResultNumber[kind="file"] { color: #48524B; font-weight: 500; }
QLabel#aiResultKind { color: #48524B; font-size: 9pt; }
QLabel#aiResultDate { color: #5D6760; font-size: 9pt; }
QLabel#aiResultSummary { color: #48524B; font-size: 9pt; }
/* The matched passage is document text: set like the paper. */
QLabel#aiResultPassage {
    color: #18211B; font-family: "Times New Roman", serif; font-size: 11pt; padding-top: 2px;
}
QWidget#aiResultRelevance { background: transparent; }
QLabel#aiResultRelevanceValue { color: #5D6760; font-size: 8.5pt; }
QProgressBar#aiResultRelevanceBar {
    background: #DCE1DC; border: none; border-radius: 2px;
    min-height: 4px; max-height: 4px;
}
QProgressBar#aiResultRelevanceBar::chunk { background: #3D6648; border-radius: 2px; }

/* Statistics and settings pages. */
QWidget#statisticsPage, QWidget#settingsPage { background: #FFFFFF; }
QLabel[role="statisticsSection"] { color: #48524B; font-size: 9pt; font-weight: 600; }

/* Index rebuild: a title, a note, the bar, the count and the document. */
QLabel#reindexTitle { color: #18211B; font-size: 10.5pt; font-weight: 600; }
QLabel#reindexNote { color: #5D6760; font-size: 9pt; }
QLabel#reindexCount { color: #48524B; font-size: 9pt; font-weight: 600; }
QLabel#reindexName, QLabel#reindexDetail { color: #48524B; font-size: 9pt; }
QLabel#reindexDetail[state="error"] { color: #B3263E; }

/* ============ AREA: dialogs ============ */
/* The secondary surfaces: the OCR progress window, the PDF preview, the
 * keyword search, About, and what floats over the workspace (the batch
 * progress, toasts, the startup overlay). A dialog is one sheet of the
 * surface colour; a floating part is the same surface with a border_strong
 * hairline and the 6px popover radius, no shadow. The painted activity ring
 * and the icons take their colours from the tokens in code. */
QDialog#progressDialog, QDialog#previewDialog,
QDialog#searchDialog, QDialog#aboutDialog { background: #FFFFFF; }

/* OCR progress: a short title, a muted line, the step and the percent. */
QLabel#progressTitle { color: #18211B; font-size: 10.5pt; font-weight: 600; }
QLabel#progressMessage { color: #5D6760; font-size: 9pt; }
QLabel#progressStatus { color: #48524B; font-size: 9pt; }
QLabel#progressPercent { color: #5D6760; font-size: 9pt; }

/* PDF preview: file name and size above the page, actions below it. */
QFrame#previewHeader { background: #FFFFFF; border: none; border-bottom: 1px solid #D5DAD5; }
QLabel#previewFileName { color: #18211B; font-size: 10pt; font-weight: 600; }
QLabel#previewFileSize { color: #5D6760; font-size: 9pt; }
QFrame#previewFooter { background: #FFFFFF; border: none; border-top: 1px solid #D5DAD5; }

/* Keyword search: the field as tall as its button, the matches as quiet
   rows under a hairline header (item text lines up with the header's). */
QLineEdit#searchField { min-height: 26px; }
QTableWidget#searchResults {
    background: #FFFFFF;
    border: none;
    selection-background-color: #E3EBE5;
    selection-color: #18211B;
}
QTableWidget#searchResults::item { padding: 0 5px; border: none; }
QTableWidget#searchResults::item:hover { background: #E8EBE8; }
QTableWidget#searchResults::item:selected { background: #E3EBE5; color: #18211B; }
QTableWidget#searchResults QHeaderView::section {
    background: #FFFFFF;
    color: #5D6760;
    font-size: 9pt;
    font-weight: 500;
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid #D5DAD5;
}
QTableWidget#searchResults QHeaderView::down-arrow { image: url(@APP_DIR@/icons/qss/chevron-down-light.svg); width: 10px; height: 10px; }
QTableWidget#searchResults QHeaderView::up-arrow { image: url(@APP_DIR@/icons/qss/chevron-up-light.svg); width: 10px; height: 10px; }
QToolButton#searchOpenButton { padding: 0; min-width: 26px; max-width: 26px; min-height: 26px; max-height: 26px; }
QLabel#searchStatus { color: #5D6760; font-size: 9pt; }
QLabel#searchStatus[tone="danger"] { color: #B3263E; }

/* About: the home page's about sheet. Name and mark are olive (set in code,
   per theme, like the toolbar mark); facts are rows between hairlines. */
QLabel#aboutTitle { font-size: 13pt; font-weight: 600; }
QLabel#aboutVersion { color: #5D6760; font-size: 9pt; }
QLabel#aboutSummary { color: #18211B; font-size: 10pt; }
QFrame#aboutFacts { background: transparent; border: none; border-top: 1px solid #D5DAD5; }
QFrame[role="aboutFact"] { background: transparent; border: none; border-bottom: 1px solid #D5DAD5; }
QLabel[role="aboutTerm"] { color: #5D6760; font-size: 9pt; }
QLabel[role="aboutValue"] { color: #18211B; font-size: 10pt; }
QLabel#aboutNote { color: #5D6760; font-size: 8.5pt; }

/* Floating over the workspace: batch progress and toasts. */
QFrame#floatingProgress { background: #FFFFFF; border: 1px solid #B7BFB8; border-radius: 6px; }
QLabel#floatingProgressTitle { color: #18211B; font-size: 9.5pt; font-weight: 600; }
QLabel#floatingProgressPercent { color: #5D6760; font-size: 9pt; }
QLabel#floatingProgressDetail { color: #48524B; font-size: 9pt; }
QFrame#floatingProgress QToolButton { padding: 0; min-width: 24px; max-width: 24px; min-height: 24px; max-height: 24px; }
QFrame#toast { background: #FFFFFF; border: 1px solid #B7BFB8; border-radius: 6px; }
QLabel#toastMessage { color: #18211B; font-size: 9.5pt; }

/* Startup overlay: the home page's startup line on a floating surface. */
QWidget#loadingOverlay { background: #FFFFFF; border: 1px solid #B7BFB8; border-radius: 6px; }
QLabel#loadingTitle { color: #18211B; font-size: 10pt; font-weight: 600; }
QLabel#loadingStatus { color: #48524B; font-size: 9pt; }
QLabel#loadingPercent { color: #5D6760; font-size: 8.5pt; }
QProgressBar#loadingBar {
    background: #D5DAD5;
    border: none;
    border-radius: 0;
    min-height: 2px;
    max-height: 2px;
}
QProgressBar#loadingBar::chunk { background: #3D6648; border-radius: 0; }
