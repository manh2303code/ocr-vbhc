# Linux test runner for OCR VBHC.
#
# This image does NOT run the application. OCR VBHC is a PyQt5 desktop program
# with no HTTP surface; 25 of its 61 modules import PyQt5. What this image does
# is execute the test suite on Linux so regressions are caught before a portable
# Windows package is cut.
#
# Python is pinned to 3.9 to match the embedded runtime declared in
# build_portable.PYTHON_VERSION. Torch is pinned to build_portable.TORCH_VERSION
# from the same CPU index the builder uses, so CI resolves the same wheels as
# production rather than whatever pip finds today.

FROM python:3.9-slim-bookworm

# Qt needs these even under the offscreen platform plugin: it still loads the
# platform library, the xcb keyboard mapping and fontconfig at import time.
RUN apt-get update && apt-get install --no-install-recommends -y \
        libgl1 \
        libegl1 \
        libglib2.0-0 \
        libdbus-1-3 \
        libfontconfig1 \
        libfreetype6 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxcb-shm0 \
        libxcb-sync1 \
        libxcb-xfixes0 \
        libxcb-xinerama0 \
        libxcb-util1 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    QT_QPA_PLATFORM=offscreen

WORKDIR /app

# Keep dependency layers cacheable: only the manifests invalidate them.
COPY requirements_portable.txt ./

# Same version and index as build_portable.step4_install_packages.
RUN pip install --upgrade pip \
    && pip install torch==2.8.0 --index-url https://download.pytorch.org/whl/cpu

# PyQtWebEngine is dropped on purpose. The landing screen guards its import and
# falls back to native Qt, and tests/test_landing.py drives that path with
# force_native=True, so CI covers the fallback without carrying ~200 MB of
# Chromium that cannot run unsandboxed in a container anyway.
RUN grep -viE '^PyQtWebEngine' requirements_portable.txt > /tmp/requirements-ci.txt \
    && pip install -r /tmp/requirements-ci.txt \
    && pip install pytest

COPY . .

# Tests that need GGUF weights or the embedded runtime skip themselves; the
# image deliberately carries source only (5.2 MB) and no model files (15.4 GB).
CMD ["pytest", "tests/", "-q", "--no-header", "-p", "no:cacheprovider"]
